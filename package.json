{
  "name": "neckguard",
  "version": "0.1.0",
  "private": true,
  "description": "NeckGuard: monitor local de postura cervical y descansos (web + Electron/macOS)",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "NeckGuard",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/juanma-valero-garzon/neckguard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanma-valero-garzon/neckguard.git"
  },
  "bugs": {
    "url": "https://github.com/juanma-valero-garzon/neckguard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs && node scripts/gen-notices.mjs",
    "dev": "vite",
    "build": "node scripts/gen-notices.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev",
    "electron:build:main": "node scripts/make-icons.mjs && tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build && npm run electron:build:main && electron .",
    "electron:pack": "npm run build && npm run electron:build:main && electron-builder --mac --universal --publish never",
    "electron:pack:dir": "npm run build && npm run electron:build:main && electron-builder --mac --dir --publish never",
    "electron:pack:win": "npm run build && npm run electron:build:main && electron-builder --win --publish never",
    "electron:pack:win:dir": "npm run build && npm run electron:build:main && electron-builder --win --x64 --dir --publish never",
    "licenses": "node scripts/gen-notices.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@mediapipe/tasks-vision": "1.2.2",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  }
}
